rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{id} {
      allow read: if true;
      allow create, update: if id.size() >= 8 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['name','answers','path','at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.answers is map
        && request.resource.data.path is list && request.resource.data.path.size() <= 12;
      allow delete: if false;
    }
  }
}
